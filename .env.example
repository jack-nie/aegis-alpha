# Aegis Alpha local release environment example.
# Copy to .env for local Docker Compose use. Do not commit real secrets.

# Compose project
COMPOSE_PROJECT_NAME=aegis-alpha

# Backend
AEGIS_ALPHA_PORT=5178
AEGIS_ALPHA_DB_URL=jdbc:mysql://mysql:3306/aegis_alpha?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
AEGIS_ALPHA_DB_USER=marketmind
AEGIS_ALPHA_DB_PASSWORD=change-me-local-db-password
AEGIS_ALPHA_SQL_INIT=always
AEGIS_ALPHA_REDIS_HOST=redis
AEGIS_ALPHA_REDIS_PORT=6379
AEGIS_ALPHA_REDIS_PASSWORD=change-me-local-redis-password
AEGIS_ALPHA_SEED_ENABLED=true
AEGIS_ALPHA_TOKEN_SECRET=change-me-local-token-secret

# LangGraph / LangChain worker
AEGIS_ALPHA_LANGCHAIN_ENABLED=true
AEGIS_ALPHA_LANGCHAIN_ENGINE_URL=http://langgraph:8787
AEGIS_ALPHA_LANGGRAPH_PORT=8787
AEGIS_ALPHA_LANGGRAPH_HOST=0.0.0.0
AEGIS_ALPHA_LANGCHAIN_PROVIDER=openai
AEGIS_ALPHA_LANGCHAIN_MODEL=gpt-4o-mini
AEGIS_ALPHA_LANGCHAIN_BASE_URL=
AEGIS_ALPHA_LANGCHAIN_API_KEY=
AEGIS_ALPHA_LANGCHAIN_TIMEOUT_MS=25000
AEGIS_ALPHA_LANGCHAIN_MOCK=true

# Frontend
AEGIS_ALPHA_FRONTEND_PORT=5174
AEGIS_ALPHA_BACKEND_INTERNAL_URL=http://backend:5178

# MySQL container
MYSQL_DATABASE=aegis_alpha
MYSQL_USER=aegis
MYSQL_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
