# Aegis Alpha local release environment example.
# Copy to .env for local Docker Compose use. Do not commit real secrets.

# Compose project
COMPOSE_PROJECT_NAME=aegis-alpha

# Backend
MARKETMIND_PORT=5178
MARKETMIND_DB_URL=jdbc:mysql://mysql:3306/aegis_alpha?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MARKETMIND_DB_USER=marketmind
MARKETMIND_DB_PASSWORD=change-me-local-db-password
MARKETMIND_SQL_INIT=always
MARKETMIND_REDIS_HOST=redis
MARKETMIND_REDIS_PORT=6379
MARKETMIND_REDIS_PASSWORD=change-me-local-redis-password
MARKETMIND_SEED_ENABLED=true
MARKETMIND_TOKEN_SECRET=change-me-local-token-secret

# LangGraph / LangChain worker
MARKETMIND_LANGCHAIN_ENABLED=true
MARKETMIND_LANGCHAIN_ENGINE_URL=http://langgraph:8787
MARKETMIND_LANGGRAPH_PORT=8787
MARKETMIND_LANGGRAPH_HOST=0.0.0.0
MARKETMIND_LANGCHAIN_PROVIDER=openai
MARKETMIND_LANGCHAIN_MODEL=gpt-4o-mini
MARKETMIND_LANGCHAIN_BASE_URL=
MARKETMIND_LANGCHAIN_API_KEY=
MARKETMIND_LANGCHAIN_TIMEOUT_MS=25000
MARKETMIND_LANGCHAIN_MOCK=true

# Frontend
MARKETMIND_FRONTEND_PORT=5174
MARKETMIND_BACKEND_INTERNAL_URL=http://backend:5178

# MySQL container
MYSQL_DATABASE=aegis_alpha
MYSQL_USER=marketmind
MYSQL_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
